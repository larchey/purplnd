# Nighttime Purple theme for btop
# Matches Hyprland nighttime theme

# Main background
theme[main_bg]="#0a0a12"

# Main text color
theme[main_fg]="#d0d0dd"

# Title color for boxes
theme[title]="#c8a0e8"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#8a64b4"

# Background color of selected items
theme[selected_bg]="#1a1a2a"

# Foreground color of selected items
theme[selected_fg]="#e0e0e8"

# Color of inactive/disabled text
theme[inactive_fg]="#555566"

# Color of text appearing on top of graphs
theme[graph_text]="#b0b0c0"

# Misc colors for processes box
theme[proc_misc]="#60a0c0"

# CPU box outline color
theme[cpu_box]="#8a64b4"

# Memory/disks box outline color
theme[mem_box]="#6a4c93"

# Network box outline color
theme[net_box]="#60a0b8"

# Processes box outline color
theme[proc_box]="#9d7cd8"

# Box divider line and target line color
theme[div_line]="#333344"

# Temperature graph color (hottest)
theme[temp_start]="#60a090"
theme[temp_mid]="#c0a060"
theme[temp_end]="#c06080"

# CPU graph colors
theme[cpu_start]="#6a4c93"
theme[cpu_mid]="#8a64b4"
theme[cpu_end]="#c8a0e8"

# Mem/Disk free meter
theme[free_start]="#404055"
theme[free_mid]="#555566"
theme[free_end]="#666677"

# Mem/Disk cached meter
theme[cached_start]="#60a0b8"
theme[cached_mid]="#70b0c8"
theme[cached_end]="#80c0d8"

# Mem/Disk available meter
theme[available_start]="#60a090"
theme[available_mid]="#70b0a0"
theme[available_end]="#80c0b0"

# Mem/Disk used meter
theme[used_start]="#6a4c93"
theme[used_mid]="#8a64b4"
theme[used_end]="#c8a0e8"

# Download graph colors
theme[download_start]="#60a0b8"
theme[download_mid]="#70b0c8"
theme[download_end]="#80c0d8"

# Upload graph colors
theme[upload_start]="#8a64b4"
theme[upload_mid]="#9d7cd8"
theme[upload_end]="#c8a0e8"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#6a4c93"
theme[process_mid]="#8a64b4"
theme[process_end]="#c8a0e8"
